{
  "schema_version": 1,
  "suite_id": "OC-Vida-Resume-Document-Extraction-v1",
  "extractor_version": 1,
  "formats": ["pdf", "docx"],
  "limits": {
    "source_maximum_bytes": 8388608,
    "pdf_maximum_pages": 50,
    "extracted_maximum_chars": 500000,
    "candidate_maximum_count": 2000,
    "candidate_maximum_chars": 8000,
    "docx_maximum_members": 2000,
    "docx_maximum_uncompressed_bytes": 33554432,
    "docx_maximum_member_bytes": 8388608,
    "docx_maximum_compression_ratio": 100,
    "worker_timeout_seconds": 15
  },
  "hard_gates": {
    "regular_file_only": true,
    "source_path_not_returned_to_webview": true,
    "source_digest_bound": true,
    "candidate_digest_bound": true,
    "candidates_initially_unselected": true,
    "review_digest_rechecked_on_admission": true,
    "profile_cas_required": true,
    "raw_source_not_persisted_in_profile_store": true,
    "external_relationships_not_fetched": true,
    "macro_or_active_content_rejected": true,
    "encrypted_pdf_rejected": true,
    "image_only_pdf_requires_separate_ocr_review": true,
    "docx_pagination_not_invented": true,
    "action_capability": "none"
  },
  "reference_implementations": [
    {
      "repository": "microsoft/markitdown",
      "commit": "fd239d5d2be43d9b68329730206b9312c7d5a388",
      "release": "v0.1.7",
      "license": "MIT",
      "observed_boundary": "PDF delegates to pdfminer.six/pdfplumber and DOCX to Mammoth; generated text does not provide the required candidate-level provenance contract"
    },
    {
      "repository": "docling-project/docling",
      "commit": "8050c42be2b179504445cb8f3c75655e27cbb662",
      "release": "v2.118.1",
      "license": "MIT",
      "observed_boundary": "structured layout and OCR quality comparator with a substantially broader model and runtime surface"
    },
    {
      "repository": "xberg-io/xberg",
      "commit": "cbbdabaea6e4d1ba2dba0374b8f3c7a5b9d79547",
      "release": "v1.0.14",
      "license": "MIT",
      "observed_boundary": "promising Rust PDF/Office geometry and reading-order comparator; adoption deferred until measured against the frozen corpus"
    },
    {
      "repository": "jsvine/pdfplumber",
      "commit": "4c64b92d5caccd71c645e98e0fabb0c4dba7ff45",
      "release": "v0.11.10",
      "license": "MIT",
      "observed_boundary": "word extraction exposes page and bounding-box evidence while logical reading order remains document-dependent"
    },
    {
      "repository": "srbhr/Resume-Matcher",
      "commit": "116f9cc3b00e1ac91734a6c2679bf41ea64a0edc",
      "release": "v1.2.0",
      "license": "Apache-2.0",
      "observed_boundary": "MarkItDown conversion is followed by LLM JSON extraction and therefore does not establish exact factual provenance"
    },
    {
      "repository": "xitanggg/open-resume",
      "commit": "4f8255a2c763479837f69f1dccf2a3338730cd79",
      "release": "none",
      "license": "AGPL-3.0",
      "observed_boundary": "behavior-only browser PDF parser reference; source is not reused"
    }
  ]
}
