{
  "schema_version": 1,
  "suite_id": "OC-Vida-Resume-Supervised-Rewrite-v1",
  "rewrite_contract_version": 1,
  "limits": {
    "selected_fact_maximum_count": 200,
    "selected_fact_maximum_chars": 8000,
    "requirement_maximum_count": 200,
    "requirement_maximum_chars": 5000,
    "provider_input_maximum_chars": 200000,
    "provider_output_maximum_chars": 200000,
    "proposal_maximum_count": 200,
    "proposal_text_maximum_chars": 8000,
    "evidence_fragment_maximum_count": 32,
    "evidence_fragment_maximum_chars": 2000,
    "provider_timeout_seconds": 120
  },
  "hard_gates": {
    "explicit_initiation": true,
    "provider_disclosed_before_egress": true,
    "remote_egress_requires_opt_in": true,
    "selected_reviewed_facts_only": true,
    "excluded_history_not_sent": true,
    "job_instructions_are_untrusted_data": true,
    "provider_tools_disabled": true,
    "closed_model_output_schema": true,
    "exact_projection_binding": true,
    "exact_fact_and_original_text_binding": true,
    "requirements_must_be_pre_mapped": true,
    "evidence_fragments_must_be_exact_substrings": true,
    "new_or_changed_protected_atoms_rejected": true,
    "proposal_level_digest_cas": true,
    "stale_source_rejected": true,
    "individual_review_required": true,
    "bulk_accept_disabled": true,
    "master_profile_immutable": true,
    "version_restore_non_destructive": true,
    "ats_or_hiring_outcome_claims_disabled": true,
    "upload_autofill_and_submit_disabled": true,
    "action_capability": "none"
  },
  "reported_metrics": [
    "schema_action_pass_rate",
    "source_binding_pass_rate",
    "protected_atom_rejection_recall",
    "prompt_injection_rejection_rate",
    "stale_decision_rejection_rate",
    "verified_proposal_yield",
    "abstention_rate",
    "human_factual_accuracy",
    "human_preference_over_exact_baseline",
    "requirement_target_usefulness",
    "provider_latency_seconds",
    "provider_failure_rate"
  ],
  "reference_implementations": [
    {
      "repository": "srbhr/Resume-Matcher",
      "commit": "116f9cc3b00e1ac91734a6c2679bf41ea64a0edc",
      "license": "Apache-2.0",
      "observed_boundary": "diff paths and original-text checks are useful; invented metrics remain warnings and job-description skills may be admitted, so the verifier is not reused as a safety gate"
    },
    {
      "repository": "AmruthPillai/Reactive-Resume",
      "commit": "c292968314390090514e3abae5d09281f8fcef39",
      "license": "MIT",
      "observed_boundary": "before/after and raw-patch review, stale patch handling, undo, and non-destructive version history are interaction references; bulk accept is not adopted"
    },
    {
      "repository": "phoinixi/resuml",
      "commit": "e214d088804b8fe8b0dacba9e03c89dcedb17e63",
      "license": "ISC",
      "observed_boundary": "browser-local structured resume and tailoring comparator; agent-driven score iteration is outside the supervised boundary"
    },
    {
      "repository": "Gsync/jobsync",
      "commit": "06d994b248b73ea57395254f5e3ccce582388ec5",
      "license": "MIT",
      "observed_boundary": "self-hosted review and job-match comparator with a broader career-assistant and tracking surface"
    },
    {
      "repository": "xitanggg/open-resume",
      "commit": "4f8255a2c763479837f69f1dccf2a3338730cd79",
      "license": "AGPL-3.0",
      "observed_boundary": "behavior-only local edit and parser-view reference; source code is not reused"
    },
    {
      "repository": "akhil-dara/CVAurum",
      "commit": "e9f8993487f784c90ce2872e2de5599a1ce7dbe4",
      "license": "MIT",
      "observed_boundary": "emerging local-first editor and deterministic-check comparator; ATS vendor simulation and score remain project claims"
    },
    {
      "repository": "ibarrajo/ApplyPilot",
      "commit": "e77ec117fa5a9fdbbb1879ace8c780a2ca6378e5",
      "license": "AGPL-3.0",
      "observed_boundary": "negative comparator for external-provider plaintext, score-driven automation, and application submission"
    }
  ]
}
